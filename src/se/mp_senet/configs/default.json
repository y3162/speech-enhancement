{
    "data": {
        "sampling_rate": 16000,
        "segment_size": 32000,
        "normalize": "energy",
        "stft": {
            "n_fft": 400,
            "hop_size": 100,
            "win_size": 400,
            "compress_factor": 0.3
        },
        "train_splits": ["train-clean-100", "train-clean-360"],
        "validation_splits": ["dev-clean"],
        "noise_config_ids": null
    },
    "model": {
        "dense_channel": 64,
        "beta": 2.0,
        "num_tsblocks": 4,
        "n_heads": 4
    },
    "train": {
        "batch_size": 16,
        "epochs": 400,
        "seed": 42,
        "num_workers": 4,
        "prefetch_factor": 2,
        "val_batch_size": 4,
        "pesq_num_workers": 4,
        "log_interval": 100,
        "optim": {
            "learning_rate": 0.0005,
            "adam_b1": 0.8,
            "adam_b2": 0.99,
            "lr_decay": 0.99
        },
        "loss": {
            "magnitude": 0.9,
            "phase": 0.3,
            "complex": 0.1,
            "consistency": 0.1,
            "time": 0.2,
            "metric": 0.05
        }
    }
}
